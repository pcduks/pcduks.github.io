# Only needed for the optional scripts. The site itself needs no keys.

# scripts/import-cv.ts and scripts/illustrate.ts (Google AI Studio key)
GEMINI_API_KEY=

# scripts/fetch-github.ts: optional. Without it, only public repositories are listed.
# A fine-grained token with read-only "Metadata" access lets the build see private repos too.
GITHUB_TOKEN=

# Base path for GitHub Pages project sites, e.g. /portfolio/ . Leave empty for a user site or a custom domain.
VITE_BASE=
